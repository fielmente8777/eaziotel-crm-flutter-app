# ============================================================
# SECRETS / KEYS - never push these to GitHub (the repo is public)
# ============================================================

# Environment files (all of them, including .env.example)
.env
.env.*
*.env

# App keys (Razorpay key etc.) and its example copy
lib/core/config/app_secrets.dart
lib/core/config/app_secrets.example.dart

# Android signing: keystore + its passwords
*.jks
*.keystore
key.properties
**/key.properties
local.properties
**/local.properties

# SHA-1 / SHA-256 signature and fingerprint notes, signing reports
*sha1*.txt
*sha-1*.txt
*sha256*.txt
*sha-256*.txt
*SHA1*
*SHA256*
*fingerprint*.txt
*signing*report*.txt
signingReport*.txt
*certificate*.txt

# Google Play app signing exports (PEPK tool output, upload certificate)
*.pepk
pepk*.jar
encrypted_private_key*
private_key*.zip
upload_certificate*
deployment_cert*
*.der
*.pem

# iOS signing: certificates, profiles, App Store Connect API keys
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*

# Firebase / Google service configs (contain project keys)
google-services.json
GoogleService-Info.plist

# Built app files (share these outside git)
*.apk
*.aab
*.ipa
*.app.dSYM.zip
